# 复制为 .env 并按需修改；.env 已被 .gitignore 忽略，不会提交
# 监听地址：0.0.0.0:8090 = 局域网可访问；127.0.0.1:8090 = 仅本机
ECHO_ADDR=127.0.0.1:8090
ECHO_DATA_DIR=data

# MySQL（首次启动会自动 CREATE DATABASE；账号需要建库权限，或先手动建库）
ECHO_MYSQL_HOST=127.0.0.1
ECHO_MYSQL_PORT=3306
ECHO_MYSQL_USER=echo
ECHO_MYSQL_PASSWORD=change-me
ECHO_MYSQL_DB=echo_service

# 凭据加密密钥：留空则自动生成 data/secret.key（32 字节 base64/hex）
ECHO_SECRET=

# 注册开关（0 关闭）
ECHO_ALLOW_REGISTRATION=1

# 登录 Token 有效期（Echo App Bearer Token）
ECHO_TOKEN_TTL=720h
# 浏览器会话有效期
SESSION_TTL=720h

# TTS 聚合服务（https://github.com/imlinhanchao/tts-service）
TTS_BASE_URL=http://127.0.0.1:8123
TTS_TIMEOUT=300s

# 可选：ffmpeg 路径（用于 MP3 编码与 MP3 分块；留空则从 PATH 查找，找不到就输出 WAV）
FFMPEG_PATH=

# zlib 镜像候选（逗号分隔）
ZLIB_DOMAINS=https://z-lib.gd,https://z-lib.gl,https://z-library.ec,https://zlib.bz

MAX_DOWNLOAD_MB=500
MAX_JOB_CHARS=500000
