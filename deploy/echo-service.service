[Unit]
Description=Echo Service — Echo App 后端（搜书/下书/听书）
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
# scripts/install-service.sh 会把 __APP_DIR__ 替换成仓库绝对路径
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/bin/echo-service
Restart=on-failure
RestartSec=5
# 配置由程序自行从同目录 .env 读取
StandardOutput=append:__APP_DIR__/.tmp/echo-service.log
StandardError=append:__APP_DIR__/.tmp/echo-service.log

[Install]
WantedBy=default.target
